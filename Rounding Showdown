import math

print("--- Task 3: Rounding Showdown ---")
value = -7.8

print("ceil  ->", math.ceil(value))
print("floor ->", math.floor(value))
print("trunc ->", math.trunc(value))

#floor() rounds down to -8, while trunc() removes the decimal part and gives -7.

print()

#OUTPUT

--- Task 3: Rounding Showdown ---
ceil  -> -7
floor -> -8
trunc -> -7
